# Local-only settings. Copy to .env; never reuse these credentials in production.
APP_ENV=development
SECRET_KEY=local-only-change-before-deployment-1234567890
REFRESH_SECRET_KEY=local-only-refresh-change-before-deployment-1234567890
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/ecommerce
ASYNC_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/ecommerce
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
POSTGRES_PORT=5433
REDIS_PORT=6379

# Optional providers are disabled unless configured.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
CLOUD_NAME_CLOUDINARY=
API_KEY_CLOUDINARY=
API_SECRET_CLOUDINARY=
